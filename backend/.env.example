# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/deepfake-detection
DB_NAME=deepfake-detection

# JWT Configuration (REQUIRED)
# Generate: openssl rand -base64 32 (see README)
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE=500000000
UPLOAD_PATH=./uploads
ALLOWED_MIME_TYPES=video/mp4,video/avi,video/mov,video/webm,audio/mpeg,audio/wav,audio/mp3,image/jpeg,image/png

# Security Configuration
BCRYPT_ROUNDS=12
# Generate: openssl rand -base64 32 | cut -c1-32
ENCRYPTION_KEY=
# Generate: openssl rand -base64 16 | cut -c1-16
ENCRYPTION_IV=

# FFmpeg Configuration (optional, defaults to 'ffmpeg' and 'ffprobe' in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Self-Learning (optional)
# LEARNING_MIN_FEEDBACK=50 - Feedback count to trigger hourly cycle (default 50)
# LEARNING_CRON="0 * * * *" - Cron for hourly check (default: every hour)
# TRAINING_CALLBACK_SECRET - If set, ML service must send X-Training-Callback-Secret header
